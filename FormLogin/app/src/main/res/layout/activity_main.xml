            android:layout_height="0dp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="@id/gc2"
            app:layout_constraintEnd_toStartOf="@id/gc3"
            app:layout_constraintTop_toTopOf="@id/gr1"
            app:layout_constraintBottom_toTopOf="@id/gr2" />

        <Button
            android:text="x"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="@id/gc3"
            app:layout_constraintEnd_toStartOf="@id/gc4"
            app:layout_constraintTop_toTopOf="@id/gr1"
            app:layout_constraintBottom_toTopOf="@id/gr2" />

        <!-- ===== HÀNG 3 ===== -->
        <Button
            android:text="4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="@id/gc0"
            app:layout_constraintEnd_toStartOf="@id/gc1"
            app:layout_constraintTop_toTopOf="@id/gr2"
            app:layout_constraintBottom_toTopOf="@id/gr3" />

        <Button

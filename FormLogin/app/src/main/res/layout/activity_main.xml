            app:layout_constraintStart_toStartOf="@id/gc1"
            app:layout_constraintEnd_toStartOf="@id/gc2"
            app:layout_constraintTop_toTopOf="@id/gr3"
            app:layout_constraintBottom_toTopOf="@id/gr4" />

        <Button
            android:text="3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="@id/gc2"
            app:layout_constraintEnd_toStartOf="@id/gc3"
            app:layout_constraintTop_toTopOf="@id/gr3"
            app:layout_constraintBottom_toTopOf="@id/gr4" />

        <Button
            android:text="+"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="@id/gc3"
            app:layout_constraintEnd_toStartOf="@id/gc4"
            app:layout_constraintTop_toTopOf="@id/gr3"
            app:layout_constraintBottom_toTopOf="@id/gr4" />

        <!-- ===== HÀNG 5 ===== -->
        <Button
            android:text="+/-"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:backgroundTint="#EEEEEE"
            android:textColor="#000000"
            app:layout_constraintStart_toStartOf="@id/gc0"
            app:layout_constraintEnd_toStartOf="@id/gc1"
            app:layout_constraintTop_toTopOf="@id/gr4"
            app:layout_constraintBottom_toTopOf="@id/gr5" />

        <Button
            android:text="0"
            android:layout_width="0dp"
